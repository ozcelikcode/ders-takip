{
  "name": "study-tracker",
  "version": "1.0.0",
  "description": "Ders Takip ve Planlama Sistemi - Full Stack Application",
  "private": true,
  "workspaces": [
    "packages/contracts",
    "backend",
    "frontend"
  ],
  "scripts": {
    "setup": "npm ci && npm run configure && npm run build",
    "dev": "npm run dev:all",
    "dev:all": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "build": "npm run build --workspaces",
    "build:backend": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "seed": "npm run seed --workspace backend",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:e2e": "tsc --project tests/e2e/tsconfig.json",
    "test:e2e": "node tests/e2e/run.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "npm run test --workspaces",
    "check:naming": "node scripts/check-naming.mjs",
    "check:text": "node scripts/check-interface-text.mjs",
    "check": "npm run check:naming && npm run check:text && npm run typecheck && npm run typecheck:e2e && npm run lint && npm test && npm run build",
    "configure": "node scripts/configure-development.mjs",
    "push:keys": "node scripts/generate-push-keys.mjs",
    "db:migrate": "npm run db:migrate --workspace backend",
    "admin:manage": "npm run admin:manage --workspace backend --",
    "pretypecheck": "npm run build --workspace @study-tracker/contracts",
    "pretest": "npm run build --workspace @study-tracker/contracts",
    "predev:all": "npm run build --workspace @study-tracker/contracts",
    "predev:backend": "npm run build --workspace @study-tracker/contracts",
    "predev:frontend": "npm run build --workspace @study-tracker/contracts",
    "test:lighthouse": "node tests/e2e/run.mjs --config playwright.lighthouse.config.ts"
  },
  "keywords": [
    "study-tracker",
    "planning",
    "react",
    "nodejs",
    "sqlite"
  ],
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "concurrently": "^8.2.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "lighthouse": "13.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "esbuild@0.28.2": true,
    "fsevents": false
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  }
}
