{
  "name": "@study-tracker/backend",
  "version": "1.0.0",
  "description": "Ders Takip ve Planlama Sistemi - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "tsx src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.cjs",
    "db:migrate": "npm run build && node dist/scripts/migrate.js",
    "admin:manage": "npm run build && node dist/scripts/manage-admin.js",
    "prebuild": "npm run build --workspace @study-tracker/contracts"
  },
  "keywords": [
    "education",
    "study-tracker",
    "planning",
    "api"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^4.2.1",
    "sequelize": "^6.37.7",
    "sqlite3": "^6.0.1",
    "zod": "^4.1.9",
    "@study-tracker/contracts": "1.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^24.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  }
}
