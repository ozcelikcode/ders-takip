# Run npm run configure to generate local development secrets.
NODE_ENV=development
PORT=5002
DB_PATH=database.sqlite
BACKUP_DIR=backups
# Optional second folder for copies of every verified snapshot (another disk or a synced folder).
BACKUP_COPY_DIR=
# Optional: where the append-only administrator log is written (default: admin-audit.jsonl next to the database).
AUDIT_LOG_PATH=

# Required: a random signing secret of at least 32 characters.
JWT_SECRET=
JWT_EXPIRE=15m
SESSION_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Optional password reset mail. Without SMTP_HOST and MAIL_FROM, administrators issue
# one-time reset links from the user list instead. Locally, Mailpit (localhost:1025) works.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional Web Push (browser reminders, also when the tab is closed). `npm run push:keys -- you@example.com`
# appends a key pair here; keep it stable, rotating it drops every browser subscription. Production needs HTTPS.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Explicit development seed only; existing accounts are never reset.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
