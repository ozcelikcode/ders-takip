# Run npm run configure to generate local development secrets.
NODE_ENV=development
PORT=5002
DB_PATH=database.sqlite
BACKUP_DIR=backups

# Required: a random signing secret of at least 32 characters.
JWT_SECRET=
JWT_EXPIRE=15m
SESSION_TTL_DAYS=7
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Explicit development seed only; existing accounts are never reset.
ADMIN_EMAIL=
ADMIN_USERNAME=
ADMIN_PASSWORD=
