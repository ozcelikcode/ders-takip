# SITE_ADDRESS is the public host name (for example study.example.com); Caddy obtains its certificate and serves
# HTTPS with HTTP/2 and HTTP/3.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	handle /api/* {
		reverse_proxy api:5002
	}

	handle {
		root * /srv
		route {
			# Pages and the service worker are checked on every visit; hashed build files never change.
			header Cache-Control "no-cache"
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			try_files {path} /index.html
			file_server
		}
	}
}
