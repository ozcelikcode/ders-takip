# Copy to deploy/.env (never committed) and fill in.
# Public host name; Caddy requests the HTTPS certificate for it.
SITE_ADDRESS=study.example.com
# At least 32 random characters: openssl rand -hex 48
JWT_SECRET=
# Optional: a second backup folder inside the container (mount it as a volume first).
BACKUP_COPY_DIR=
# Optional email for password resets and reminders.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Optional browser push: npm run push:keys -- you@example.com prints a pair.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
