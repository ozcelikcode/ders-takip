        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "luxon": "3.7.2",
    "zod": "^4.1.9"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "typescript": "~5.9.3"
  }
}
