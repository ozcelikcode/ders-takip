{
  "name": "@study-tracker/frontend",
  "version": "1.0.0",
  "description": "Ders Takip ve Planlama Sistemi - Frontend React App",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
