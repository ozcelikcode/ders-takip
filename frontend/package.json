{
  "name": "@study-tracker/frontend",
  "version": "1.0.0",
  "description": "Ders Takip ve Planlama Sistemi - Frontend React App",
  "type": "module",
  "scripts": {
    "dev": "vite --force",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "test": "vitest run",
    "prebuild": "npm run build --workspace @study-tracker/contracts"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
