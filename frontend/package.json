    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "5.9.1",
    "@study-tracker/contracts": "1.0.0",
    "@tanstack/react-query": "^5.8.4",
    "clsx": "^2.0.0",
    "date-fns": "^4.1.0",
    "lucide-react": "1.61.0",
    "luxon": "3.7.2",
    "motion": "13.5.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-is": "19.3.1",
    "react-router-dom": "^7.18.4",
